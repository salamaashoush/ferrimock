/target
*.swp
*.swo
*~
.DS_Store
node_modules/
*.node
bun.lock
dist/
# CLI platform packages assembled at release time (npm-shim/scripts/prepare.mjs)
crates/ferrimock-cli/npm-shim/npm/

# Benchmark runs: machine-specific numbers, and they record the directory
# they ran in. Keep them local.
benchmarks/results/

# Fuzzing: the build tree and the crash artifacts are per-machine. The corpus is
# too large and too machine-shaped to track; a checked-in seed corpus would go
# in fuzz/seeds/ instead.
fuzz/target/
fuzz/corpus/
fuzz/artifacts/
fuzz/Cargo.lock

# proptest writes a regression seed on failure. Keeping it is deliberate -- a
# counterexample that took a fuzzer to find should be replayed forever.
!crates/*/proptest-regressions/
